# Copy this file to ".env" and fill it in.
PORT=3000
NODE_ENV=development

# MySQL / MariaDB (XAMPP defaults: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kapet_balay_db

# Any long random text (16+ characters). Used to sign login cookies.
SESSION_SECRET=change-me-to-a-long-random-text
